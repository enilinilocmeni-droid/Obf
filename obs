local TrackedNPCs = {}
local NPCPullConnections = {}

local function SetupNPCPull()
    for _, conn in ipairs(NPCPullConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(NPCPullConnections)
    
    if not AutoFarmSettings.PullNPCs then 
        table.clear(TrackedNPCs)
        return 
    end
    
    local function IsValidNPC(npc)
        if not npc or not npc:IsA("Model") then return false end
        if Players:GetPlayerFromCharacter(npc) then return false end
        
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return false end
        
        local root = npc:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then return false end
        
        if root.Anchored == true then 
            return false 
        end
        
        local parentName = npc.Parent and npc.Parent.Name or ""
        local isNPCFolder = (parentName == "HoodLocal" or parentName == "Zombies" or parentName == "ZombieLocal")
        local nameMatch = npc.Name:match("^Hood") or npc.Name:match("^Zombie") or npc.Name:match("^NPC")
        if not (nameMatch or isNPCFolder) then return false end
        
        return true
    end
    
    local function ProcessNPC(npc)
        if not npc or TrackedNPCs[npc] then return end
        if not IsValidNPC(npc) then return end
        
        TrackedNPCs[npc] = true
        
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local root = npc:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local pos = hrp.Position + hrp.CFrame.LookVector * 5
        root.CFrame = CFrame.new(pos + Vector3.new(
            math.random(-3, 3),
            0,
            math.random(-3, 3)
        ))
        
        if AutoFarmSettings.FreezeNPCs then
            root.Anchored = true
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            if humanoid then
                pcall(function()
                    humanoid.WalkSpeed = 0
                    humanoid.JumpPower = 0
                    humanoid.AutoRotate = false
                end)
            end
        end
        
        print("?? NPC " .. npc.Name .. " tlport et freeze")
    end
    
    local function HookFolder(folder)
        if not folder then return end
        
        for _, npc in ipairs(folder:GetChildren()) do
            if IsValidNPC(npc) then
                task.spawn(ProcessNPC, npc)
            end
        end
        
        local addConn = folder.ChildAdded:Connect(function(npc)
            if not AutoFarmSettings.PullNPCs then return end
            task.wait(0.2)
            if IsValidNPC(npc) then
                print("?? Nouveau NPC dtect: " .. npc.Name)
                ProcessNPC(npc)
            end
        end)
        table.insert(NPCPullConnections, addConn)
        
        local remConn = folder.ChildRemoved:Connect(function(npc)
            TrackedNPCs[npc] = nil
        end)
        table.insert(NPCPullConnections, remConn)
    end
    
    local candidateFolders = {"HoodLocal", "Zombies", "ZombieLocal", "NPCs", "Bots"}
    for _, fName in ipairs(candidateFolders) do
        local f = workspace:FindFirstChild(fName)
        if f then
            HookFolder(f)
        end
    end
    
    local wsConn = workspace.ChildAdded:Connect(function(child)
        if not AutoFarmSettings.PullNPCs then return end
        if table.find(candidateFolders, child.Name) then
            HookFolder(child)
        elseif child:IsA("Model") and (child.Name:match("^Zombie") or child.Name:match("^Hood")) then
            task.wait(0.2)
            if IsValidNPC(child) then
                ProcessNPC(child)
            end
        end
    end)
    table.insert(NPCPullConnections, wsConn)
    
    print("?? NPC Pull System activ - Surveillance HoodLocal & Zombies")
end
