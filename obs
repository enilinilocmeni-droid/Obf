local function UpdateBotESP()
    if not AutoFarmSettings.Enabled then return end
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myPos = myChar.HumanoidRootPart.Position

    if not AutoFarmSettings.ShowBotESP then
        for bot, _ in pairs(BotESPObjects) do
            RemoveBotESP(bot)
        end
        return
    end

    local bots = (GetBots and GetBots()) or {}
    local activeBotMap = {}
    for _, bot in ipairs(bots) do
        activeBotMap[bot] = true
        if not BotESPObjects[bot] then
            CreateBotESP(bot)
        end
    end

    for bot, esp in pairs(BotESPObjects) do
        if not activeBotMap[bot] or not bot or not bot.Parent or not esp.rootPart or not esp.rootPart.Parent then
            RemoveBotESP(bot)
        else
            local humanoid = bot:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then
                RemoveBotESP(bot)
            else
