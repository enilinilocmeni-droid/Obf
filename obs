                        end
                    end
                end

                -- 3. Recherche dans CostumeFX
                if costumeFX then
                    local d = costumeFX:FindFirstChild(idStr)
                    if d then return d end
                    for _, ch in ipairs(costumeFX:GetChildren()) do
                        if ch.Name == idStr or ch.Name:find(idStr, 1, true) then
                            return ch
                        end
                    end
                end

                -- 4. Recherche dans les autres dossiers de ReplicatedStorage
                local knownFolders = {"Skins", "Wardrobe", "Costumes", "Models", "Assets", "Items", "Characters", "Weapons", "CustomSkins"}
                for _, fName in ipairs(knownFolders) do
                    local folder = RS:FindFirstChild(fName)
