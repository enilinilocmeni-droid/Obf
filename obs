                            end
                        end
                    else
                        for _, line in pairs(esp.skeleton) do
                            if line then
                                line.Visible = false
                            end
                        end
                    end
                else
                    esp.billboard.Enabled = false
                    esp.highlight.Enabled = false
                    if esp.skeleton then
                        for _, line in pairs(esp.skeleton) do
                            if line then line.Visible = false end
                        end
                    end
                end
            else
                esp.billboard.Enabled = false
                esp.highlight.Enabled = false
                if esp.skeleton then
                    for _, line in pairs(esp.skeleton) do
                        if line then line.Visible = false end
                    end
                end
            end
