            local function CleanupSkin()
                for _, c in ipairs(SkinConnections) do
                    pcall(function() c:Disconnect() end)
                end
                table.clear(SkinConnections)

                if SkinRigidConstraint then
                    pcall(function() SkinRigidConstraint:Destroy() end)
                    SkinRigidConstraint = nil
                end
                if SkinWeld then
                    pcall(function() SkinWeld:Destroy() end)
                    SkinWeld = nil
                end
                if SkinHandleAtt then
                    pcall(function() SkinHandleAtt:Destroy() end)
                    SkinHandleAtt = nil
                end
                if SkinModel then
                    pcall(function() SkinModel:Destroy() end)
                    SkinModel = nil
                end

                local character = LocalPlayer.Character
                if character then
                    pcall(function()
                        character:SetAttribute("CostumeFX", nil)
                    end)
                    -- Restaurer toutes les propriétés cachées d'origine
                    for inst, origVal in pairs(SkinHiddenProps) do
                        if inst and inst.Parent then
                            pcall(function()
                                if inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture") then
                                    inst.Transparency = origVal
                                elseif inst:IsA("WrapLayer") then
                                    inst.Enabled = origVal
                                end
                            end)
                        end
                    end
                end
                table.clear(SkinHiddenProps)
            end

            local function HideCharacterInstance(inst)
                if not inst or not inst.Parent then return end
                -- Ne jamais masquer les objets du costume ni les armes
                if SkinModel and inst:IsDescendantOf(SkinModel) then return end
                if inst:FindFirstAncestorOfClass("Tool") then return end

                if inst:IsA("BasePart") then
                    -- Ne pas cacher le HumanoidRootPart ni les mains (visibles pour tenir les armes)
                    if inst.Name == "HumanoidRootPart" or inst.Name == "LeftHand" or inst.Name == "RightHand" then
                        return
                    end
                    if SkinHiddenProps[inst] == nil then
                        SkinHiddenProps[inst] = inst.Transparency
                    end
                    inst.Transparency = 1
                    local conn = inst:GetPropertyChangedSignal("Transparency"):Connect(function()
                        if MiscSettings.ModelChanger and inst.Transparency ~= 1 then
                            inst.Transparency = 1
                        end
                    end)
                    table.insert(SkinConnections, conn)

                elseif inst:IsA("Decal") or inst:IsA("Texture") then
                    if SkinHiddenProps[inst] == nil then
                        SkinHiddenProps[inst] = inst.Transparency
                    end
                    inst.Transparency = 1
                    local conn = inst:GetPropertyChangedSignal("Transparency"):Connect(function()
                        if MiscSettings.ModelChanger and inst.Transparency ~= 1 then
                            inst.Transparency = 1
                        end
                    end)
                    table.insert(SkinConnections, conn)

                elseif inst:IsA("WrapLayer") then
                    -- Vêtements 3D (Layered Clothing : hoodie, pantalons, etc.)
                    if SkinHiddenProps[inst] == nil then
                        SkinHiddenProps[inst] = inst.Enabled
                    end
                    inst.Enabled = false
                    local conn = inst:GetPropertyChangedSignal("Enabled"):Connect(function()
                        if MiscSettings.ModelChanger and inst.Enabled ~= false then
                            inst.Enabled = false
                        end
                    end)
                    table.insert(SkinConnections, conn)
                end
            end

