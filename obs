                -- Système de liaison pour les Bots (HoodLocal / Farm Bots)
                local function HookBot(bot)
                    if not bot or not bot:IsA("Model") then return end
                    if KillFX_BotHooked[bot] then return end
                    KillFX_BotHooked[bot] = true

                    local hum = bot:FindFirstChildOfClass("Humanoid")
                    local hrp = bot:FindFirstChild("HumanoidRootPart") or bot:FindFirstChildWhichIsA("BasePart")
                    local lastRecordedHP = hum and hum.Health or 100
                    local lastBotPos = hrp and hrp.Position or nil
                    local hasDied = false

                    local function TriggerBotKill()
                        if hasDied then return end
                        if not KillEffectsSettings.Enabled or not KillEffectsSettings.ApplyToBots then return end

                        if KillEffectsSettings.OnlyMyKills then
                            local lastDmgTime = KillFX_LastDmgBy[bot] or 0
                            local recentDmg = (tick() - lastDmgTime <= 4.0)
                            local isAttacking = IsLocalShooting() or AutoFarmSettings.Enabled
                            if not recentDmg and not isAttacking then
                                return
                            end
                        end

                        hasDied = true
                        local spawnPos = (hrp and hrp.Parent and hrp.Position) or lastBotPos
                        PlayKillEffect(bot, KillEffectsSettings.SelectedEffect, spawnPos)
                        KillFX_LastDmgBy[bot] = nil
                        KillFX_BotHooked[bot] = nil
                    end

                    local function SetupBotHum(h)
                        hum = h
                        lastRecordedHP = h.Health
                        h.HealthChanged:Connect(function(newHP)
                            if newHP < lastRecordedHP then
                                if IsLocalShooting() or AutoFarmSettings.Enabled then
                                    KillFX_LastDmgBy[bot] = tick()
                                end
                            end
                            lastRecordedHP = newHP
                            if newHP <= 0 then
                                TriggerBotKill()
                            end
                        end)
                        h.Died:Connect(function()
                            TriggerBotKill()
                        end)
                    end

                    if hum then
                        SetupBotHum(hum)
                    else
                        local conn
                        conn = bot.ChildAdded:Connect(function(child)
                            if child:IsA("Humanoid") then
                                conn:Disconnect()
                                SetupBotHum(child)
                            end
                        end)
                    end

                    task.spawn(function()
                        while bot and bot.Parent and not hasDied do
                            if hrp and hrp.Parent then
                                lastBotPos = hrp.Position
                            end
                            if hum and (hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead) then
                                TriggerBotKill()
                                break
                            end
                            task.wait(0.1)
                        end
