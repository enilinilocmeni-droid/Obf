                -- 7. 🎃 BULLET TRACER HALLOWEEN (Exclusif au joueur local)
                -- Chemin exact de la photo: ReplicatedStorage.FX.Tracers.MuzzleFlash1.Halloween
                local function GetHalloweenTracerFolder()
                    local fx = RS:FindFirstChild("FX") or RS:FindFirstChild("Fx")
                    if fx then
                        local tracers = fx:FindFirstChild("Tracers") or fx:FindFirstChild("tracers")
                        if tracers then
                            local mf1 = tracers:FindFirstChild("MuzzleFlash1") or tracers:FindFirstChild("MuzzleFlash")
                            if mf1 then
                                local hw = mf1:FindFirstChild("Halloween")
                                if hw then return hw end
                            end
                            local hwDirect = tracers:FindFirstChild("Halloween", true)
                            if hwDirect then return hwDirect end
                        end
                    end
                    return RS:FindFirstChild("Halloween", true)
                end

                local function GetLocalMuzzlePosition()
                    local char = LocalPlayer.Character
                    if not char then
                        return Camera.CFrame.Position
                    end
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        local muzzle = tool:FindFirstChild("MuzzleFlash1", true)
                            or tool:FindFirstChild("Muzzle", true)
                            or tool:FindFirstChild("FirePoint", true)
                            or tool:FindFirstChild("Barrel", true)
                            or tool:FindFirstChild("Flash", true)
                        if muzzle then
                            if muzzle:IsA("Attachment") then
                                return muzzle.WorldPosition
                            elseif muzzle:IsA("BasePart") then
                                return muzzle.Position
                            end
                        end
                        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
                        if handle then
                            return (handle.CFrame * CFrame.new(0, 0, -1.8)).Position
                        end
                    end
                    return (Camera.CFrame * CFrame.new(0.4, -0.3, -1.2)).Position
                end

                local function GetLocalTracerTarget(startPos)
                    local mouse = LocalPlayer:GetMouse()
                    local rayOrigin = Camera.CFrame.Position
                    local rayDir = (mouse.Hit and (mouse.Hit.Position - rayOrigin).Unit or Camera.CFrame.LookVector) * 1000
                    local params = RaycastParams.new()
                    params.FilterDescendantsInstances = { LocalPlayer.Character }
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    local res = workspace:Raycast(rayOrigin, rayDir, params)
                    if res then
                        return res.Position
                    elseif mouse.Hit then
                        return mouse.Hit.Position
                    end
                    return rayOrigin + rayDir
                end

                local lastTracerTick = 0
                local function SpawnHalloweenTracer()
                    if not MiscSettings.HalloweenBulletTracer then return end
                    local char = LocalPlayer.Character
                    if not char then return end

                    local now = tick()
                    if now - lastTracerTick < 0.05 then return end
                    lastTracerTick = now

                    local hwFolder = GetHalloweenTracerFolder()
                    if not hwFolder then return end

                    local startPos = GetLocalMuzzlePosition()
                    local targetPos = GetLocalTracerTarget(startPos)

                    -- A) Muzzle Flash & Sparks Halloween
                    pcall(function()
                        local muzzleAtt = Instance.new("Attachment")
                        muzzleAtt.WorldPosition = startPos
                        muzzleAtt.Parent = workspace.Terrain

                        local mEmitter = hwFolder:FindFirstChild("Muzzle")
                        if mEmitter and mEmitter:IsA("ParticleEmitter") then
                            local c = mEmitter:Clone()
                            c.Parent = muzzleAtt
                            c.Enabled = false
                            c:Emit(c:GetAttribute("EmitCount") or 14)
                        end

                        local sEmitter = hwFolder:FindFirstChild("Sparks")
                        if sEmitter and sEmitter:IsA("ParticleEmitter") then
                            local c = sEmitter:Clone()
                            c.Parent = muzzleAtt
                            c.Enabled = false
                            c:Emit(c:GetAttribute("EmitCount") or 10)
                        end

                        local mfPart = hwFolder:FindFirstChild("MuzzleFlash")
                        if mfPart then
                            local exp = mfPart:FindFirstChildWhichIsA("ParticleEmitter", true)
                            if exp then
                                local c = exp:Clone()
                                c.Parent = muzzleAtt
                                c.Enabled = false
                                c:Emit(c:GetAttribute("EmitCount") or 8)
                            end
                        end

                        task.delay(0.5, function()
                            pcall(function() muzzleAtt:Destroy() end)
                        end)
                    end)

                    -- B) Beams Tracer Halloween (Commencer -> End)
                    pcall(function()
                        local templateTracer = hwFolder:FindFirstChild("Tracer")
                        if not templateTracer then return end

                        local tracerClone = templateTracer:Clone()
                        local attStart = tracerClone:FindFirstChild("Commencer", true)
                        local attEnd = tracerClone:FindFirstChild("End", true)

                        if not attStart or not attEnd then
                            local atts = {}
                            for _, obj in ipairs(tracerClone:GetDescendants()) do
                                if obj:IsA("Attachment") then
                                    table.insert(atts, obj)
                                end
                            end
                            if #atts >= 2 then
                                attStart = attStart or atts[1]
                                attEnd = attEnd or atts[2]
                            end
                        end

                        if attStart and attEnd then
                            attStart.Parent = workspace.Terrain
                            attEnd.Parent = workspace.Terrain
                            attStart.WorldPosition = startPos
                            attEnd.WorldPosition = targetPos

                            local beams = {}
                            for _, obj in ipairs(tracerClone:GetDescendants()) do
                                if obj:IsA("Beam") then
                                    obj.Attachment0 = attStart
                                    obj.Attachment1 = attEnd
                                    obj.Enabled = true
                                    table.insert(beams, obj)
                                end
                            end

                            tracerClone.Parent = workspace.Terrain

                            task.spawn(function()
                                local lifetime = 0.22
                                local startTime = tick()
                                while tick() - startTime < lifetime do
                                    local elapsed = tick() - startTime
                                    local alpha = math.clamp(elapsed / lifetime, 0, 1)
                                    for _, beam in ipairs(beams) do
                                        beam.Transparency = NumberSequence.new(math.clamp(alpha * 1.3, 0, 1))
                                    end
                                    task.wait()
                                end
                                pcall(function()
                                    tracerClone:Destroy()
                                    attStart:Destroy()
                                    attEnd:Destroy()
                                end)
                            end)
                        else
                            tracerClone:Destroy()
                        end
                    end)
                end

                -- Déclencheur exclusif au joueur local (Arme en main)
                local function HookLocalTool(tool)
