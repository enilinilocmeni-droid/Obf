local AutoShootCooldown = 0.1
local IsAutoAiming = false
local LastAutoETime = 0
local AutoECooldown = 0.3
local function AutoShoot()
    if not AutoFarmSettings.Enabled or not AutoFarmSettings.AutoShoot then 
        if IsAutoAiming then
            local vim = game:GetService("VirtualInputManager")
            local mouse = game:GetService("Players").LocalPlayer:GetMouse()
            vim:SendMouseButtonEvent(mouse.X, mouse.Y, 1, false, game, 0)
            IsAutoAiming = false
        end
        return 
    end
    local currentTime = tick()
    local targetBot = GetClosestBot()
