            local function IsVisible(targetPart)
                if not AimbotSettings.VisibilityCheck then return true end
                local character = LocalPlayer.Character
                if not character then return false end
                local head = character:FindFirstChild("Head")
                if not head then return false end
                local origin = head.Position
                local direction = (targetPart.Position - origin)
                local raycastParams = RaycastParams.new()
                raycastParams.FilterDescendantsInstances = {character, targetPart.Parent}
                raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                raycastParams.IgnoreWater = true
                local rayResult = workspace:Raycast(origin, direction, raycastParams)
                if not rayResult then
                    return true
                end
                if rayResult.Instance:IsDescendantOf(targetPart.Parent) then
                    return true
                end
                local hitPart = rayResult.Instance
                if hitPart.Name:lower():find("foliage") or 
                hitPart.Name:lower():find("bush") or 
                hitPart.Name:lower():find("grass") or
                hitPart.Name:lower():find("leaf") or
                hitPart.Name:lower():find("tree") or
                hitPart.Name:lower():find("plant") then
                    return true
                end
                if hitPart.Name:lower():find("car") or 
                hitPart.Name:lower():find("vehicle") or 
                hitPart.Name:lower():find("truck") or
                hitPart.Name:lower():find("van") then
                    return true
                end
                if hitPart.Name:lower():find("window") or 
                hitPart.Name:lower():find("glass") or
                hitPart.Transparency > 0.5 then
                    return true
                end
                if not hitPart.CanCollide then
                    return true
                end
                if hitPart.Size.Magnitude < 3 then
                    return true
                end
                return false
            end
            local function GetClosestTarget()
                if AutoFarmSettings.Enabled and AutoFarmSettings.TargetBots then
                    local myChar = LocalPlayer.Character
                    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                        local myPos = myChar.HumanoidRootPart.Position
                        local closestBot = nil
                        local closestDistance = math.huge
                        local botList = (GetBots and GetBots()) or {}
                        for _, bot in ipairs(botList) do
                            if bot and bot.Parent then
                                local rootPart = bot:FindFirstChild("HumanoidRootPart")
                                local humanoid = bot:FindFirstChildOfClass("Humanoid")
                                if rootPart and humanoid and humanoid.Health > 0 then
                                    local state = humanoid:GetState()
                                    if state ~= Enum.HumanoidStateType.Dead and 
                                       state ~= Enum.HumanoidStateType.Physics and
                                       state ~= Enum.HumanoidStateType.None then
                                        local distance = (rootPart.Position - myPos).Magnitude
                                        local maxDist = AutoFarmSettings.MaxKillDistance or 15
                                        if distance < closestDistance and distance <= maxDist then
                                            closestBot = bot
                                            closestDistance = distance
                                        end
                                    end
                                end
                            end
                        end
                        if closestBot then
                            return {Character = closestBot, isBot = true}
                        end
                    end
                end
                if not AimbotSettings.Enabled and not AimbotSettings.SilentAimEnabled then return nil end
                local MaximumDistance = AimbotSettings.SilentAimEnabled and AimbotSettings.SilentFOV or AimbotSettings.FOV
