                            local n = ch.Name:lower()
                            if n:find("135336389839889") or n:find("10132663") or n:find("reaper") or n:find("robe") or n:find("cloak") then
                                return ch
                            end
                        end
                    end
                    -- Téléchargement catalogue direct de l'Accessoire via executor par son ID catalogue 135336389839889
                    local ok, asset = pcall(function()
                        return game:GetObjects("rbxassetid://135336389839889")[1]
                    end)
                    if ok and asset then
                        return asset
                    end
                end

                -- 2. Recherche par ID direct dans WardrobeModels
                if wardrobe then
                    local d = wardrobe:FindFirstChild(idStr)
                    if d then return d end
                    for _, ch in ipairs(wardrobe:GetChildren()) do
                        if ch.Name == idStr or ch.Name:find(idStr, 1, true) then
