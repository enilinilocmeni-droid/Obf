            local function bat_worldBounds(parts)
                local mn = Vector3.new(math.huge, math.huge, math.huge)
                local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
                for _, p in ipairs(parts) do
                    local cf, h = p.CFrame, p.Size / 2
                    for _, sx in ipairs({ -1, 1 }) do
                        for _, sy in ipairs({ -1, 1 }) do
                            for _, sz in ipairs({ -1, 1 }) do
                                local v = cf:PointToWorldSpace(Vector3.new(sx * h.X, sy * h.Y, sz * h.Z))
                                mn = mn:Min(v)
                                mx = mx:Max(v)
                            end
                        end
                    end
                end
                return mn, mx
            end

            local function bat_characterExtentsY(char)
                local list = {}
                for _, p in ipairs(char:GetChildren()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart"
                        and not p.Name:find("Arm") and not p.Name:find("Hand") then
                        table.insert(list, p)
                    end
                end
                if #list == 0 then return nil end
                local mn, mx = bat_worldBounds(list)
                return mn.Y, mx.Y
            end

            local function bat_fitBlock(clone, parts, id, root, fit, isMain, noAutoRot)
                clone:PivotTo(CFrame.new(clone:GetPivot().Position))
                local mn, mx = bat_worldBounds(parts)
                local size = mx - mn

                if isMain and size.Y > 0.01 then
                    local k = bat_adjS[id] or 1
                    if bat_autoSize and fit.height > 0.5 then k = k * fit.height / size.Y end
                    local wm, dm = bat_adjW[id] or 1, bat_adjD[id] or 1
                    local ok = pcall(function()
                        if clone:IsA("Model") then
                            clone:ScaleTo(clone:GetScale() * k)
                        else
                            local s = clone.Size
                            clone.Size = Vector3.new(s.X * k * wm, s.Y * k, s.Z * k * dm)
                        end
                    end)
                    if ok then
                        mn, mx = bat_worldBounds(parts)
                        size = mx - mn
                    end
                end

                local autoRot = (noAutoRot or size.X >= size.Z) and 0 or 90
                local c = (mn + mx) / 2
                local R = root.CFrame.Rotation * CFrame.Angles(0, math.rad(autoRot + (bat_adjRot[id] or 0)), 0)
                clone:PivotTo(CFrame.new(c) * R * CFrame.new(-c) * clone:GetPivot())

                mn, mx = bat_worldBounds(parts)
                local cx, cz = (mn.X + mx.X) / 2, (mn.Z + mx.Z) / 2
                clone:PivotTo(clone:GetPivot() + Vector3.new(
                    root.Position.X - cx,
                    fit.feetY - mn.Y + (bat_adjY[id] or 0),
                    root.Position.Z - cz
                ))
            end

