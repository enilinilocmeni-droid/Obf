                lbl.TextXAlignment = Enum.TextXAlignment.Left
                local track = Instance.new("TextButton", row)
                track.Size = UDim2.new(0, 30, 0, 14)
                track.Position = UDim2.new(1, -34, 0.5, -7)
                track.BackgroundColor3 = default and C.toggleOn or C.toggleOff
                track.Text = ""
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
                local knob = Instance.new("Frame", track)
                knob.Size = UDim2.new(0, 10, 0, 10)
                knob.Position = default and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                knob.BorderSizePixel = 0
                Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
                local active = default
                local ti = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
                local function setToggle(val)
                    if active ~= val then
                        active = val
                        TweenService:Create(track, ti, {BackgroundColor3 = active and C.toggleOn or C.toggleOff}):Play()
                        TweenService:Create(knob, ti, {Position = active and UDim2.new(1,-12,0.5,-5) or UDim2.new(0,2,0.5,-5)}):Play()
                        callback(active)
                    end
                end
                track.MouseButton1Click:Connect(function()
                    setToggle(not active)
                end)
                return function(newVal)
                    if newVal ~= nil then
                        setToggle(newVal)
                    end
                    return active
                end
            end
            local function AddSlider(parent, text, default, min, max, callback)
                local wrap = Instance.new("Frame", parent)
                wrap.Size = UDim2.new(1, 0, 0, 36)
                wrap.BackgroundTransparency = 1
                local lbl = Instance.new("TextLabel", wrap)
                lbl.Text = text .. ":  " .. default
                lbl.Size = UDim2.new(1, -4, 0, 16)
                lbl.Position = UDim2.new(0, 4, 0, 0)
                lbl.BackgroundTransparency = 1
                lbl.TextColor3 = C.textPri
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 12
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                local track = Instance.new("Frame", wrap)
                track.Size = UDim2.new(1, -8, 0, 6)
                track.Position = UDim2.new(0, 4, 0, 22)
                track.BackgroundColor3 = C.sliderBg
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
                local stroke2 = Instance.new("UIStroke", track)
                stroke2.Color = C.border
                stroke2.Thickness = 1
                local fill = Instance.new("Frame", track)
                fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
                fill.BackgroundColor3 = C.sliderFill
                fill.BorderSizePixel = 0
                Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
                local dragging = false
                local function update(x)
                    local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + (max - min) * pct)
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    lbl.Text = text .. ":  " .. val
                    callback(val)
                end
                track.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then 
                        dragging=true
                        update(i.Position.X) 
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then 
                        update(i.Position.X) 
                    end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then 
                        dragging = false 
                    end
                end)
            end
