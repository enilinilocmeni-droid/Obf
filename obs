local function UpdateBotESP()
    if not AutoFarmSettings.Enabled or not AutoFarmSettings.ShowBotESP then return end
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myPos = myChar.HumanoidRootPart.Position
    local bots = GetBots()
    for _, bot in pairs(bots) do
        if not BotESPObjects[bot] then
            CreateBotESP(bot)
        end
    end
    for bot, esp in pairs(BotESPObjects) do
        if not bot or not bot.Parent or not esp.rootPart or not esp.rootPart.Parent then
            RemoveBotESP(bot)
        else
            local humanoid = bot:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then
                RemoveBotESP(bot)
            else
                local state = humanoid:GetState()
                if state == Enum.HumanoidStateType.Dead or 
                   state == Enum.HumanoidStateType.Physics or
                   state == Enum.HumanoidStateType.None then
                    RemoveBotESP(bot)
                else
                    local distance = (esp.rootPart.Position - myPos).Magnitude
                    local distLabel = esp.billboard.Frame:FindFirstChild("Distance")
                    if distLabel then
                        local meters = distance / 3.5
                        distLabel.Text = string.format("%.0fm", meters)
                    end
                end
            end
        end
    end
