            local function bat_trySlice(source)
                bat_sliceError = nil
                if source.MeshId == "" then return nil, "MeshId vide" end

                local ok, em = pcall(function()
                    return AssetService:CreateEditableMeshAsync(Content.fromUri(source.MeshId))
                end)
                if not ok or not em then
                    return nil, "EditableMesh refusé : " .. tostring(em)
                end

                local okAll, res = pcall(function()
                    local faces = em:GetFaces()
                    local pos = {}
                    local function P(v)
                        local q = pos[v]
                        if not q then q = em:GetPosition(v) pos[v] = q end
                        return q
                    end

                    local info = {}
                    local mn = Vector3.new(math.huge, math.huge, math.huge)
                    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
                    for i, f in ipairs(faces) do
                        local vs = em:GetFaceVertices(f)
                        local a, b, c = P(vs[1]), P(vs[2]), P(vs[3])
                        info[i] = { f = f, vs = vs, c = (a + b + c) / 3 }
                        mn = mn:Min(a):Min(b):Min(c)
                        mx = mx:Max(a):Max(b):Max(c)
                        if i % 3000 == 0 then task.wait() end
                    end
                    if #info == 0 then error("mesh sans faces") end

                    local meshSize = mx - mn
                    local H = math.max(meshSize.Y, 0.001)
                    local HS = math.max(meshSize.X / 2, 0.001)
                    local cx = (mn.X + mx.X) / 2
                    local cFull = (mn + mx) / 2
                    local scale = Vector3.new(
                        source.Size.X / math.max(meshSize.X, 0.001),
                        source.Size.Y / math.max(meshSize.Y, 0.001),
                        source.Size.Z / math.max(meshSize.Z, 0.001))
                    local origin = BAT_SLICE.recentered and cFull or Vector3.zero

                    local zl, nl, zc, nc = 0, 0, 0, 0
                    for _, it in ipairs(info) do
                        local ax = math.abs(it.c.X - cx)
                        local t = (it.c.Y - mn.Y) / H
                        if t < BAT_SLICE.ankle and ax < BAT_SLICE.legHalfW * HS then
                            zl += it.c.Z nl += 1
                        elseif t < 0.45 and ax > BAT_SLICE.legHalfW * HS then
                            zc += it.c.Z nc += 1
                        end
                    end
                    local zLeg = nl > 0 and zl / nl or (mn.Z + mx.Z) / 2
                    local sBack = (nc > 0 and (zc / nc - zLeg) < 0) and -1 or 1

                    local function regionOf(c)
                        local x = c.X - cx
                        local ax = math.abs(x)
                        local t = (c.Y - mn.Y) / H
                        local side = ((x < 0) ~= BAT_SLICE.swapSides) and "Left" or "Right"

                        if BAT_SLICE.cutHead and t > BAT_SLICE.neck and ax < BAT_SLICE.headHalfW * HS then return "Head" end
                        if t > BAT_SLICE.armMinT and ax > BAT_SLICE.shoulder * HS then
                            if ax < BAT_SLICE.elbow * HS then return side .. "UpperArm" end
                            if ax < BAT_SLICE.wrist * HS then return side .. "LowerArm" end
                            return side .. "Hand"
                        end
                        if t < BAT_SLICE.hip and ax < BAT_SLICE.legHalfW * HS
                            and (c.Z - zLeg) * sBack < BAT_SLICE.capeDepth then
                            if t > BAT_SLICE.knee then return side .. "UpperLeg" end
                            if t > BAT_SLICE.ankle then return side .. "LowerLeg" end
                            return side .. "Foot"
                        end
                        return "Torso"
                    end

                    local regions = {}
                    local armY, armZ, armN = { Left = 0, Right = 0 }, { Left = 0, Right = 0 }, { Left = 0, Right = 0 }
                    for _, it in ipairs(info) do
                        local name = regionOf(it.c)
                        local r = regions[name]
                        if not r then r = { faces = {} } regions[name] = r end
                        table.insert(r.faces, it)
                        local side = name:match("^(Left)") or name:match("^(Right)")
                        if side and (name:find("Arm") or name:find("Hand")) then
                            armY[side] += it.c.Y armZ[side] += it.c.Z armN[side] += 1
                        end
                    end

                    if BAT_SLICE.overlap > 0 then
                        local o = BAT_SLICE.overlap * H
                        local offs = { Vector3.new(o, 0, 0), Vector3.new(-o, 0, 0), Vector3.new(0, o, 0), Vector3.new(0, -o, 0) }
                        for _, it in ipairs(info) do
                            local own = regionOf(it.c)
                            local seen = { [own] = true }
                            for _, d in ipairs(offs) do
                                local r2 = regionOf(it.c + d)
                                if not seen[r2] then
                                    seen[r2] = true
                                    local rr = regions[r2]
                                    if not rr then rr = { faces = {} } regions[r2] = rr end
                                    table.insert(rr.faces, it)
                                end
                            end
                        end
                    end

                    local pivotLocal = {}
                    for _, side in ipairs({ "Left", "Right" }) do
                        if armN[side] > 0 then
                            local sgn = ((side == "Left") ~= BAT_SLICE.swapSides) and -1 or 1
                            local pm = Vector3.new(cx + sgn * BAT_SLICE.shoulder * HS, armY[side] / armN[side], armZ[side] / armN[side])
                            pivotLocal[side] = (pm - origin) * scale
                        end
                    end

                    local model = Instance.new("Model")
                    model.Name = "Sliced"
                    local partsList = {}

                    for name, r in pairs(regions) do
                        local cmn = Vector3.new(math.huge, math.huge, math.huge)
                        local cmx = Vector3.new(-math.huge, -math.huge, -math.huge)
                        for _, it in ipairs(r.faces) do
                            for k = 1, 3 do
                                local p = P(it.vs[k])
                                cmn = cmn:Min(p)
                                cmx = cmx:Max(p)
                            end
                        end
                        local cc = (cmn + cmx) / 2

                        local mesh = AssetService:CreateEditableMesh()
                        local vmap, uvmap, nmap = {}, {}, {}
                        for n, it in ipairs(r.faces) do
                            local ids = {}
                            for k = 1, 3 do
                                local ov = it.vs[k]
                                local nv = vmap[ov]
                                if not nv then nv = mesh:AddVertex(P(ov) - cc) vmap[ov] = nv end
                                ids[k] = nv
                            end
                            local nf = mesh:AddTriangle(ids[1], ids[2], ids[3])

                            local uvs = em:GetFaceUVs(it.f)
                            if uvs then
                                local nu = {}
                                for k = 1, 3 do
                                    local ou = uvs[k]
                                    local nn = uvmap[ou]
                                    if not nn then nn = mesh:AddUV(em:GetUV(ou)) uvmap[ou] = nn end
                                    nu[k] = nn
                                end
                                mesh:SetFaceUVs(nf, nu)
                            end
                            local nrm = em:GetFaceNormals(it.f)
                            if nrm then
                                local nn2 = {}
                                for k = 1, 3 do
                                    local on = nrm[k]
                                    local nn = nmap[on]
                                    if not nn then nn = mesh:AddNormal(em:GetNormal(on)) nmap[on] = nn end
                                    nn2[k] = nn
                                end
                                mesh:SetFaceNormals(nf, nn2)
                            end
                            if n % 2000 == 0 then task.wait() end
                        end

                        local mp = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
                        table.insert(bat_liveMeshes, mesh)
                        mp.Name = name
                        mp.Size = mp.Size * scale
                        mp.TextureID = source.TextureID
                        mp.Material = source.Material
                        pcall(function() mp.DoubleSided = source.DoubleSided or BAT_SLICE.doubleSided end)
                        for _, ch in ipairs(source:GetChildren()) do
                            if ch:IsA("SurfaceAppearance") then ch:Clone().Parent = mp end
                        end
                        mp.Anchored = true
                        mp.CanCollide = false
                        mp.CanTouch = false
                        mp.CanQuery = false
                        mp.Massless = true

                        local cf = CFrame.new((cc - origin) * scale)
                        local side = name:match("^(Left)") or name:match("^(Right)")
                        if BAT_SLICE.armDrop ~= 0 and side and (name:find("Arm") or name:find("Hand")) and pivotLocal[side] then
                            local pv = pivotLocal[side]
                            local ang = math.rad(BAT_SLICE.armDrop) * (side == "Left" and 1 or -1)
                            if BAT_SLICE.swapSides then ang = -ang end
                            cf = CFrame.new(pv) * CFrame.Angles(0, 0, ang) * CFrame.new(-pv) * cf
                        end
                        mp.CFrame = cf
                        mp.Parent = model
                        table.insert(partsList, mp)
                    end

                    return { model = model, parts = partsList }
                end)

                em:Destroy()
                if not okAll then return nil, tostring(res) end
                return res
            end

            local BAT_R15_NAMES = {
                Head = true, Torso = true, UpperTorso = true, LowerTorso = true,
                LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
