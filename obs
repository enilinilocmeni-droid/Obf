                if isRobe then
                    if wardrobe then
                        -- Nom officiel dans le jeu : "135336389839889"
                        local src = wardrobe:FindFirstChild("135336389839889") or wardrobe:FindFirstChild("101326635064310")
                        if src then return src end
                        for _, ch in ipairs(wardrobe:GetChildren()) do
