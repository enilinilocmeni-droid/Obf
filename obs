                                    if glowSpecs then
                                        local clonedGlow = glowSpecs:Clone()
                                        clonedGlow.Parent = attachment
                                        clonedGlow.Enabled = true
                                        
                                        -- S'assurer que les propriétés sont correctes
                                        if clonedGlow:IsA("ParticleEmitter") then
