local TrackedNPCs = {}
local NPCPullConnection = nil

local function SetupNPCPull()
    if NPCPullConnection then
        NPCPullConnection:Disconnect()
        NPCPullConnection = nil
    end
    
    if not AutoFarmSettings.PullNPCs then 
        table.clear(TrackedNPCs)
        return 
    end
    
    local folder = workspace:FindFirstChild("HoodLocal")
    if not folder then 
        warn("⚠️ HoodLocal folder introuvable")
        return 
    end
    
    -- Fonction pour vérifier si c'est un vrai NPC qui spawn (pas un joueur, pas déjà gelé)
    local function IsValidNPC(npc)
        if not npc:IsA("Model") then return false end
        
        -- Vérifier que ce n'est pas un joueur
        if Players:GetPlayerFromCharacter(npc) then return false end
        
        -- Vérifier qu'il a un Humanoid vivant
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return false end
        
        -- Vérifier qu'il a un HumanoidRootPart
        local root = npc:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then return false end
        
        -- CRITIQUE: Ignorer les NPCs déjà anchored (déjà gelés)
        if root.Anchored == true then 
            return false 
        end
        
        -- Vérifier que le NPC bouge vraiment (pas un model statique)
        if humanoid.WalkSpeed == 0 then return false end
        
        -- Vérifier que c'est bien un NPC du jeu (commence par Hood)
        if not npc.Name:match("^Hood%d+") then return false end
        
        return true
    end
    
    -- Fonction pour téléporter et freeze un NPC
    local function ProcessNPC(npc)
        if TrackedNPCs[npc] then return end
        if not IsValidNPC(npc) then return end
        
        TrackedNPCs[npc] = true
        
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local root = npc:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        -- Téléporter devant le joueur
        local pos = hrp.Position + hrp.CFrame.LookVector * 5
        root.CFrame = CFrame.new(pos + Vector3.new(
            math.random(-3, 3),
            0,
            math.random(-3, 3)
        ))
        
        -- Freeze si activé
        if AutoFarmSettings.FreezeNPCs then
            root.Anchored = true
            
            -- Désactiver l'IA du NPC
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            if humanoid then
                pcall(function()
                    humanoid.WalkSpeed = 0
                    humanoid.JumpPower = 0
                    humanoid.AutoRotate = false
                end)
            end
        end
        
        print("✅ NPC " .. npc.Name .. " téléporté et freeze")
    end
    
    -- NE PAS traiter les NPCs existants au démarrage (ils sont souvent déjà gelés)
    -- On surveille UNIQUEMENT les nouveaux spawns
    
    -- Surveiller les nouveaux spawns
    NPCPullConnection = folder.ChildAdded:Connect(function(npc)
        if not AutoFarmSettings.PullNPCs then return end
        
        -- Attendre que le NPC soit complètement chargé et commence à bouger
        task.wait(0.3)
        
        if IsValidNPC(npc) then
            print("🆕 Nouveau NPC détecté: " .. npc.Name)
            ProcessNPC(npc)
        end
    end)
    
    -- Nettoyer les NPCs supprimés de la liste
    folder.ChildRemoved:Connect(function(npc)
        TrackedNPCs[npc] = nil
    end)
    
    print("✅ NPC Pull System activé - Surveillance des NOUVEAUX spawns uniquement")
end
