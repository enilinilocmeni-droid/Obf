                if source.MeshId == "" then return nil, "MeshId vide" end

                local ok, em = pcall(function()
                    return AssetService:CreateEditableMeshAsync(Content.fromUri(source.MeshId))
                end)
                if not ok or not em then
                    return nil, "EditableMesh refusé : " .. tostring(em)
                end

                local okAll, res = pcall(function()
                    local faces = em:GetFaces()
                    local pos = {}
                    local function P(v)
                        local q = pos[v]
                        if not q then q = em:GetPosition(v) pos[v] = q end
                        return q
                    end

                    local info = {}
                    local mn = Vector3.new(math.huge, math.huge, math.huge)
                    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
                    for i, f in ipairs(faces) do
                        local vs = em:GetFaceVertices(f)
                        local a, b, c = P(vs[1]), P(vs[2]), P(vs[3])
                        info[i] = { f = f, vs = vs, c = (a + b + c) / 3 }
                        mn = mn:Min(a):Min(b):Min(c)
                        mx = mx:Max(a):Max(b):Max(c)
                        if i % 3000 == 0 then task.wait() end
                    end
                    if #info == 0 then error("mesh sans faces") end

                    local meshSize = mx - mn
                    local H = math.max(meshSize.Y, 0.001)
                    local HS = math.max(meshSize.X / 2, 0.001)
                    local cx = (mn.X + mx.X) / 2
                    local cFull = (mn + mx) / 2
                    local scale = Vector3.new(
                        source.Size.X / math.max(meshSize.X, 0.001),
                        source.Size.Y / math.max(meshSize.Y, 0.001),
                        source.Size.Z / math.max(meshSize.Z, 0.001))
                    local origin = BAT_SLICE.recentered and cFull or Vector3.zero

                    local zl, nl, zc, nc = 0, 0, 0, 0
                    for _, it in ipairs(info) do
                        local ax = math.abs(it.c.X - cx)
                        local t = (it.c.Y - mn.Y) / H
                        if t < BAT_SLICE.ankle and ax < BAT_SLICE.legHalfW * HS then
                            zl += it.c.Z nl += 1
                        elseif t < 0.45 and ax > BAT_SLICE.legHalfW * HS then
                            zc += it.c.Z nc += 1
                        end
                    end
                    local zLeg = nl > 0 and zl / nl or (mn.Z + mx.Z) / 2
                    local sBack = (nc > 0 and (zc / nc - zLeg) < 0) and -1 or 1

                    local function regionOf(c)
                        local x = c.X - cx
                        local ax = math.abs(x)
                        local t = (c.Y - mn.Y) / H
                        local side = ((x < 0) ~= BAT_SLICE.swapSides) and "Left" or "Right"

                        if BAT_SLICE.cutHead and t > BAT_SLICE.neck and ax < BAT_SLICE.headHalfW * HS then return "Head" end
                        if t > BAT_SLICE.armMinT and ax > BAT_SLICE.shoulder * HS then
                            if ax < BAT_SLICE.elbow * HS then return side .. "UpperArm" end
                            if ax < BAT_SLICE.wrist * HS then return side .. "LowerArm" end
                            return side .. "Hand"
                        end
                        if t < BAT_SLICE.hip and ax < BAT_SLICE.legHalfW * HS
                            and (c.Z - zLeg) * sBack < BAT_SLICE.capeDepth then
                            if t > BAT_SLICE.knee then return side .. "UpperLeg" end
                            if t > BAT_SLICE.ankle then return side .. "LowerLeg" end
                            return side .. "Foot"
                        end
                        return "Torso"
                    end

                    local regions = {}
                    local armY, armZ, armN = { Left = 0, Right = 0 }, { Left = 0, Right = 0 }, { Left = 0, Right = 0 }
                    for _, it in ipairs(info) do
                        local name = regionOf(it.c)
                        local r = regions[name]
                        if not r then r = { faces = {} } regions[name] = r end
                        table.insert(r.faces, it)
                        local side = name:match("^(Left)") or name:match("^(Right)")
                        if side and (name:find("Arm") or name:find("Hand")) then
                            armY[side] += it.c.Y armZ[side] += it.c.Z armN[side] += 1
                        end
                    end

                    if BAT_SLICE.overlap > 0 then
                        local o = BAT_SLICE.overlap * H
                        local offs = { Vector3.new(o, 0, 0), Vector3.new(-o, 0, 0), Vector3.new(0, o, 0), Vector3.new(0, -o, 0) }
                        for _, it in ipairs(info) do
                            local own = regionOf(it.c)
                            local seen = { [own] = true }
                            for _, d in ipairs(offs) do
                                local r2 = regionOf(it.c + d)
                                if not seen[r2] then
                                    seen[r2] = true
                                    local rr = regions[r2]
                                    if not rr then rr = { faces = {} } regions[r2] = rr end
                                    table.insert(rr.faces, it)
                                end
                            end
                        end
                    end

                    local pivotLocal = {}
                    for _, side in ipairs({ "Left", "Right" }) do
                        if armN[side] > 0 then
                            local sgn = ((side == "Left") ~= BAT_SLICE.swapSides) and -1 or 1
                            local pm = Vector3.new(cx + sgn * BAT_SLICE.shoulder * HS, armY[side] / armN[side], armZ[side] / armN[side])
                            pivotLocal[side] = (pm - origin) * scale
                        end
                    end

                    local model = Instance.new("Model")
                    model.Name = "Sliced"
                    local partsList = {}

                    for name, r in pairs(regions) do
                        local cmn = Vector3.new(math.huge, math.huge, math.huge)
                        local cmx = Vector3.new(-math.huge, -math.huge, -math.huge)
                        for _, it in ipairs(r.faces) do
                            for k = 1, 3 do
                                local p = P(it.vs[k])
                                cmn = cmn:Min(p)
                                cmx = cmx:Max(p)
                            end
                        end
                        local cc = (cmn + cmx) / 2

                        local mesh = AssetService:CreateEditableMesh()
                        local vmap, uvmap, nmap = {}, {}, {}
                        for n, it in ipairs(r.faces) do
                            local ids = {}
                            for k = 1, 3 do
                                local ov = it.vs[k]
                                local nv = vmap[ov]
                                if not nv then nv = mesh:AddVertex(P(ov) - cc) vmap[ov] = nv end
                                ids[k] = nv
                            end
                            local nf = mesh:AddTriangle(ids[1], ids[2], ids[3])

                            local uvs = em:GetFaceUVs(it.f)
                            if uvs then
                                local nu = {}
                                for k = 1, 3 do
                                    local ou = uvs[k]
                                    local nn = uvmap[ou]
                                    if not nn then nn = mesh:AddUV(em:GetUV(ou)) uvmap[ou] = nn end
                                    nu[k] = nn
                                end
                                mesh:SetFaceUVs(nf, nu)
                            end
                            local nrm = em:GetFaceNormals(it.f)
                            if nrm then
                                local nn2 = {}
                                for k = 1, 3 do
                                    local on = nrm[k]
                                    local nn = nmap[on]
                                    if not nn then nn = mesh:AddNormal(em:GetNormal(on)) nmap[on] = nn end
                                    nn2[k] = nn
                                end
                                mesh:SetFaceNormals(nf, nn2)
                            end
                            if n % 2000 == 0 then task.wait() end
                        end

                        local mp = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
                        table.insert(bat_liveMeshes, mesh)
                        mp.Name = name
                        mp.Size = mp.Size * scale
                        mp.TextureID = source.TextureID
                        mp.Material = source.Material
                        pcall(function() mp.DoubleSided = source.DoubleSided or BAT_SLICE.doubleSided end)
                        for _, ch in ipairs(source:GetChildren()) do
                            if ch:IsA("SurfaceAppearance") then ch:Clone().Parent = mp end
                        end
                        mp.Anchored = true
                        mp.CanCollide = false
                        mp.CanTouch = false
                        mp.CanQuery = false
                        mp.Massless = true

                        local cf = CFrame.new((cc - origin) * scale)
                        local side = name:match("^(Left)") or name:match("^(Right)")
                        if BAT_SLICE.armDrop ~= 0 and side and (name:find("Arm") or name:find("Hand")) and pivotLocal[side] then
                            local pv = pivotLocal[side]
                            local ang = math.rad(BAT_SLICE.armDrop) * (side == "Left" and 1 or -1)
                            if BAT_SLICE.swapSides then ang = -ang end
                            cf = CFrame.new(pv) * CFrame.Angles(0, 0, ang) * CFrame.new(-pv) * cf
                        end
                        mp.CFrame = cf
                        mp.Parent = model
                        table.insert(partsList, mp)
                    end

                    return { model = model, parts = partsList }
                end)

                em:Destroy()
                if not okAll then return nil, tostring(res) end
                return res
            end

            local BAT_R15_NAMES = {
                Head = true, Torso = true, UpperTorso = true, LowerTorso = true,
                LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
                RightUpperArm = true, RightLowerArm = true, RightHand = true,
                LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
                RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
            }

            local function bat_dropArms(byName, angleDeg)
                if angleDeg == 0 then return end
                local ref = byName.Torso or byName.UpperTorso or byName.Head
                if not ref then return end
                local tmn, tmx = bat_worldBounds({ ref })
                local cxm = (tmn.X + tmx.X) / 2
                for _, side in ipairs({ "Left", "Right" }) do
                    local up = byName[side .. "UpperArm"]
                    if up then
                        local mn, mx = bat_worldBounds({ up })
                        local sgn = ((mn.X + mx.X) / 2 < cxm) and 1 or -1
                        local innerX = (sgn == 1) and mx.X or mn.X
                        local pv = Vector3.new(innerX, (mn.Y + mx.Y) / 2, (mn.Z + mx.Z) / 2)
                        local rot = CFrame.new(pv) * CFrame.Angles(0, 0, math.rad(angleDeg) * sgn) * CFrame.new(-pv)
                        for _, n in ipairs({ "UpperArm", "LowerArm", "Hand" }) do
                            local part = byName[side .. n]
                            if part then part.CFrame = rot * part.CFrame end
                        end
                    end
                end
            end

            local function bat_loadPrecut(id, sourceMesh)
                local RS = game:GetService("ReplicatedStorage")
                local wardrobe = RS:FindFirstChild("WardrobeModels")
                local folder = wardrobe and wardrobe:FindFirstChild(tostring(id) .. "_Parts")
                if not folder then return nil end

                local model = Instance.new("Model")
                model.Name = "Pieces"
                local parts, byName, known = {}, {}, 0
                for _, d in ipairs(folder:GetDescendants()) do
                    if d:IsA("BasePart") then
                        local c = d:Clone()
                        for _, x in ipairs(c:GetDescendants()) do
                            if x:IsA("JointInstance") or x:IsA("Constraint") or x:IsA("BaseScript") then x:Destroy() end
                        end
                        c.Anchored = true
                        c.CanCollide = false
                        c.CanTouch = false
                        c.CanQuery = false
                        c.Massless = true
                        if c:IsA("MeshPart") then
                            pcall(function() c.DoubleSided = sourceMesh.DoubleSided or BAT_SLICE.doubleSided end)
                        end
                        if not c:FindFirstChildOfClass("SurfaceAppearance") then
                            for _, ch in ipairs(sourceMesh:GetChildren()) do
                                if ch:IsA("SurfaceAppearance") then ch:Clone().Parent = c end
                            end
                            if c:IsA("MeshPart") then c.TextureID = sourceMesh.TextureID end
                        end
                        c.Parent = model
                        table.insert(parts, c)
                        byName[c.Name] = c
                        if BAT_R15_NAMES[c.Name] then known += 1 end
                    end
                end
                if known < 3 then
                    warn("⚠️ " .. id .. "_Parts : noms de pièces non reconnus")
                    model:Destroy()
                    return nil
                end

                local mn, mx = bat_worldBounds(parts)
                local h = (mx - mn).Y
                if h > 0.01 and sourceMesh.Size.Y > 0.01 then
                    model:ScaleTo(model:GetScale() * (sourceMesh.Size.Y / h))
                end
                bat_dropArms(byName, BAT_SLICE.armDrop)
                return { model = model, parts = parts }
            end

            local function bat_attachModel(source, id, char, root, playerTorso, fit, isMain)
                local clone = source:Clone()
                local userOffset = bat_adjY[id] or 0
                local tok = bat_applyId

                local nativeMotors = {}
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("Motor6D") then
                        table.insert(nativeMotors, d)
                    elseif d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Constraint")
                        or d:IsA("Humanoid") or d:IsA("AnimationController") or d:IsA("Animator")
                        or d:IsA("BaseScript") then
                        d:Destroy()
                    end
                end

                local playerMotors = {}
                for _, m in ipairs(char:GetDescendants()) do
                    if m:IsA("Motor6D") and not (bat_skinFolder and m:IsDescendantOf(bat_skinFolder))
                        and not playerMotors[m.Name] then
                        playerMotors[m.Name] = m
                    end
                end

                local nativeMirrors = {}
                for _, m in ipairs(nativeMotors) do
                    local pm = playerMotors[m.Name]
                    if pm then table.insert(nativeMirrors, { m, pm }) end
                end
                local nativeOK = #nativeMotors >= 3 and #nativeMirrors >= 3

                if not nativeOK then
                    for _, m in ipairs(nativeMotors) do m:Destroy() end
                    if clone:IsA("BasePart") and clone.Name == "HumanoidRootPart" then
                        clone:Destroy()
                        return 0, 0, "vide"
                    end
                    for _, d in ipairs(clone:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name == "HumanoidRootPart" then d:Destroy() end
                    end
                end

                local parts = {}
                local nameToPart = {}
                local function prep(p)
                    p.Anchored = false
                    p.CanCollide = false
                    p.CanTouch = false
                    p.CanQuery = false
                    p.Massless = true
                    table.insert(parts, p)
                    if not nameToPart[p.Name] then nameToPart[p.Name] = p end
                end
                if clone:IsA("BasePart") then prep(clone) end
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("BasePart") then prep(d) end
                end

                if #parts == 0 then
                    warn("⚠️ Aucune BasePart dans", source.Name)
                    clone:Destroy()
                    return 0, 0, "vide"
                end

                -- MODE 1 : RIG NATIF
                if nativeOK then
                    local isPart1 = {}
                    for _, m in ipairs(nativeMotors) do isPart1[m.Part1] = true end

                    local rootPiece
                    for _, p in ipairs(parts) do
                        if not isPart1[p] then
                            if p.Name == "HumanoidRootPart" then rootPiece = p break end
                            rootPiece = rootPiece or p
                        end
                    end
                    rootPiece = rootPiece or parts[1]

                    clone.Parent = bat_skinFolder

                    local attach
                    if rootPiece.Name == "HumanoidRootPart" then
                        attach = root
                        local target = root.CFrame * CFrame.new(0, userOffset, 0)
                            * CFrame.Angles(0, math.rad(bat_adjRot[id] or 0), 0)
                        clone:PivotTo(target * rootPiece.CFrame:Inverse() * clone:GetPivot())
                    else
                        attach = playerTorso
                        bat_fitBlock(clone, parts, id, root, fit, isMain)
                    end

                    for _, p in ipairs(parts) do
                        if not isPart1[p] and p ~= rootPiece then
                            local w = Instance.new("Weld")
                            w.Name = "SkinWeld"
                            w.Part0 = rootPiece
                            w.Part1 = p
                            w.C0 = rootPiece.CFrame:ToObjectSpace(p.CFrame)
                            w.C1 = CFrame.new()
                            w.Parent = p
                        end
                    end

                    local w = Instance.new("Weld")
                    w.Name = "SkinRootWeld"
                    w.Part0 = attach
                    w.Part1 = rootPiece
                    w.C0 = attach.CFrame:ToObjectSpace(rootPiece.CFrame)
                    w.C1 = CFrame.new()
                    w.Parent = rootPiece

                    table.insert(bat_connections, RunService.RenderStepped:Connect(function()
                        for _, pair in ipairs(nativeMirrors) do
                            if pair[2].Parent then pair[1].Transform = pair[2].Transform end
                        end
                    end))

                    return #nativeMirrors, #parts, "rig natif"
                end

                -- MODE 2 : RIG DU JOUEUR (Motor6D)
                local matchedMotors = {}
                local jointedNames = {}
                for _, m in ipairs(char:GetDescendants()) do
                    if m:IsA("Motor6D") and m.Part0 and m.Part1
                        and not (bat_skinFolder and m:IsDescendantOf(bat_skinFolder))
                        and nameToPart[m.Part1.Name] and not jointedNames[m.Part1.Name] then
                        table.insert(matchedMotors, m)
                        jointedNames[m.Part1.Name] = true
                    end
                end

                if #matchedMotors >= 5 then
                    local refPart
                    for _, n in ipairs({ "UpperTorso", "Torso", "LowerTorso" }) do
                        if jointedNames[n] then refPart = nameToPart[n] break end
                    end
                    refPart = refPart or nameToPart[matchedMotors[1].Part1.Name]

                    local rel = {}
                    for _, p in ipairs(parts) do rel[p] = refPart.CFrame:ToObjectSpace(p.CFrame) end

                    local jointed, mirrors = {}, {}
                    for _, pm in ipairs(matchedMotors) do
                        local p1 = nameToPart[pm.Part1.Name]
                        local p0 = nameToPart[pm.Part0.Name]
                        local c0 = pm.C0
                        if not p0 or p0 == p1 then
                            p0 = pm.Part0
                            c0 = CFrame.new(0, userOffset, 0) * c0
                        end
                        local mo = Instance.new("Motor6D")
                        mo.Name = "SkinMotor_" .. pm.Name
                        mo.Part0 = p0
                        mo.Part1 = p1
                        mo.C0 = c0
                        mo.C1 = pm.C1
                        mo.Parent = p1
                        jointed[p1] = true
                        table.insert(mirrors, { mo, pm })
                    end

                    for _, p in ipairs(parts) do
                        if not jointed[p] and p ~= refPart then
                            local w = Instance.new("Weld")
                            w.Name = "SkinWeld"
                            w.Part0 = refPart
                            w.Part1 = p
                            w.C0 = rel[p]
                            w.C1 = CFrame.new()
                            w.Parent = p
                        end
                    end

                    clone.Parent = bat_skinFolder

                    table.insert(bat_connections, RunService.RenderStepped:Connect(function()
                        for _, pair in ipairs(mirrors) do
                            if pair[2].Parent then pair[1].Transform = pair[2].Transform end
                        end
                    end))

                    return #mirrors, #parts, "rig joueur"
                end

                -- MODE 3S : DÉCOUPE EN MEMBRES
                local precut = (clone:IsA("MeshPart") and #parts == 1) and bat_loadPrecut(id, clone) or nil
                if precut or (bat_useSlice and clone:IsA("MeshPart") and #parts == 1) then
                    local pieces, err = precut, nil
                    if not pieces then pieces, err = bat_trySlice(clone) end
                    if tok ~= bat_applyId then
                        if pieces then pieces.model:Destroy() end
                        clone:Destroy()
                        return 0, 0, "annulé"
                    end
                    if pieces then
                        local model = pieces.model
                        model.Parent = bat_skinFolder
                        bat_fitBlock(model, pieces.parts, id, root, fit, isMain, true)
                        local binds = {}
                        for _, mp in ipairs(pieces.parts) do
                            local tname = (mp.Name == "Torso") and "UpperTorso" or mp.Name
                            local target = char:FindFirstChild(tname) or playerTorso
                            mp.Anchored = true
                            table.insert(binds, {
                                mp = mp, name = tname, target = target,
                                off = target.CFrame:ToObjectSpace(mp.CFrame),
                            })
                        end
                        table.insert(bat_connections, RunService.RenderStepped:Connect(function()
                            for _, b in ipairs(binds) do
                                local t = b.target
                                if not (t and t.Parent and t:IsDescendantOf(char)) then
                                    t = char:FindFirstChild(b.name)
                                    b.target = t
                                end
                                if t then b.mp.CFrame = t.CFrame * b.off else bat_lostBinds += 1 end
                            end
                        end))
                        clone:Destroy()
                        return #pieces.parts, #pieces.parts, "découpé ✂"
                    else
                        bat_sliceError = tostring(err)
                        warn("⚠️ Découpe impossible : " .. bat_sliceError)
                    end
                end

                -- MODE 3 : BLOC (mesh unique) + faux mouvement
                clone.Parent = bat_skinFolder
                bat_fitBlock(clone, parts, id, root, fit, isMain)

                local welds = {}
                for _, p in ipairs(parts) do
                    local w = Instance.new("Weld")
                    w.Name = "SkinWeld"
                    w.Part0 = playerTorso
                    w.Part1 = p
                    w.C0 = playerTorso.CFrame:ToObjectSpace(p.CFrame)
                    w.C1 = CFrame.new()
                    w.Parent = p
                    table.insert(welds, { w, w.C0 })
                end

                if bat_fakeAnim then
                    local feetPoint = playerTorso.CFrame:PointToObjectSpace(
                        Vector3.new(root.Position.X, fit.feetY, root.Position.Z))
                    local t0, smooth = os.clock(), 0
                    table.insert(bat_connections, RunService.RenderStepped:Connect(function(dt)
                        local v = root.AssemblyLinearVelocity
                        local sp = Vector3.new(v.X, 0, v.Z).Magnitude
                        smooth += (math.min(sp / 16, 1.5) - smooth) * math.min(dt * 8, 1)
                        local t = os.clock() - t0

                        local bob = math.abs(math.sin(t * 9)) * 0.12 * smooth + math.sin(t * 1.5) * 0.03
                        local lean = math.rad(8) * smooth
                        local roll = math.sin(t * 4.5) * math.rad(3) * smooth

                        local off = CFrame.new(feetPoint)
                            * CFrame.Angles(-lean, 0, roll)
                            * CFrame.new(-feetPoint)
                            * CFrame.new(0, bob, 0)
                        for _, e in ipairs(welds) do e[1].C0 = off * e[2] end
                    end))
                end

                return 0, #parts, bat_sliceError and ("bloc (✂ refusé: " .. bat_sliceError:sub(1, 60) .. ")") or "bloc"
            end

            local function bat_applyNow(costume)
                bat_applyId += 1
                local myId = bat_applyId
                bat_cleanup()
                bat_currentCostume = costume
                bat_modeText = ""
                if not costume then
                    if bat_refreshStatus then bat_refreshStatus() end
                    return
                end

                local char = LocalPlayer.Character
                if not char then return end
                bat_appliedChar = char
                bat_lostBinds = 0
                local root = char:FindFirstChild("HumanoidRootPart")
                local playerTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not root or not playerTorso then
                    warn("⚠️ HumanoidRootPart ou torse introuvable")
                    return
                end

                local RS = game:GetService("ReplicatedStorage")
                local wardrobe = RS:FindFirstChild("WardrobeModels")
                if not wardrobe then warn("⚠️ WardrobeModels introuvable") return end

                local measuredFeet, topY = bat_characterExtentsY(char)
                if not topY then warn("⚠️ Impossible de mesurer le joueur") return end
                local feetY = measuredFeet
                if hum and hum.RigType == Enum.HumanoidRigType.R15 then
                    feetY = root.Position.Y - (hum.HipHeight + root.Size.Y / 2)
                end
                local fit = { feetY = feetY, height = topY - feetY }

                -- range l'arme en main avant d'enregistrer les poses des membres
                local heldTool = char:FindFirstChildOfClass("Tool")
                if heldTool and hum then
                    hum:UnequipTools()
                    task.wait(0.4)
                    if myId ~= bat_applyId or LocalPlayer.Character ~= char then
                        if heldTool.Parent == LocalPlayer.Backpack and hum.Parent then hum:EquipTool(heldTool) end
                        return
                    end
                end

                bat_skinFolder = Instance.new("Folder")
                bat_skinFolder.Name = "DevSkin"
                bat_skinFolder.Parent = char

                local source = wardrobe:FindFirstChild(tostring(costume.id))
                if source then
                    local ok, a, total, mode = pcall(bat_attachModel, source, costume.id, char, root, playerTorso, fit, true)
                    if ok then
                        print(("✅ %s : %d parties, mode %s"):format(costume.name, total, mode))
                        bat_modeText = mode
                    else
                        warn("⚠️ Erreur sur", costume.id, a)
                        bat_modeText = "erreur"
                    end
                else
                    warn("⚠️ Introuvable dans WardrobeModels:", costume.id)
                    bat_modeText = "introuvable"
                end

                if bat_hidePlayer then bat_makeCharacterInvisible(char) end

                -- remet l'arme en main
                if heldTool and hum and hum.Parent and heldTool.Parent == LocalPlayer.Backpack then
                    hum:EquipTool(heldTool)
                end

                if bat_refreshStatus then bat_refreshStatus() end
            end

            local bat_applying = 0
            local bat_pendingChar = nil
            local function bat_apply(costume)
                bat_applying += 1
