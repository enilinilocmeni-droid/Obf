local function GetClosestBot()
    if not AutoFarmSettings.Enabled or not AutoFarmSettings.TargetBots then return nil end
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    local myHead = myChar:FindFirstChild("Head")
    if not myHead then return nil end
    
    local closestBot = nil
    local closestDistance = math.huge
    
    for bot, esp in pairs(BotESPObjects) do
        if bot and bot.Parent and esp.rootPart and esp.rootPart.Parent then
            local humanoid = bot:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local state = humanoid:GetState()
                if state ~= Enum.HumanoidStateType.Dead and 
                   state ~= Enum.HumanoidStateType.Physics and
                   state ~= Enum.HumanoidStateType.None then
                    local distance = (esp.rootPart.Position - myPos).Magnitude
                    if distance <= 300 then
                        -- 🔍 VISIBLE CHECK TÊTE : priorité absolue sur la tête du bot
                        local headPart = bot:FindFirstChild("Head")
                        if headPart and headPart.Parent then
                            local direction = (headPart.Position - myHead.Position)
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {myChar, bot}
                            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                            raycastParams.IgnoreWater = true
                            
                            local rayResult = workspace:Raycast(myHead.Position, direction, raycastParams)
                            local isVisible = (not rayResult) or (rayResult.Instance and rayResult.Instance:IsDescendantOf(bot))
                            
                            if isVisible and distance < closestDistance then
                                closestBot = bot
                                closestDistance = distance
                            end
                        end
                    end
                end
            end
        end
    end
    return closestBot
end
