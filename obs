                        localLastClickTime = tick()
                    end)
                    Mouse.Button1Up:Connect(function()
                        isLocalMouseDown = false
                    end)
                end)

                local function IsLocalShooting()
                    if isLocalMouseDown then return true end
                    local ok, pressed = pcall(function()
                        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                    end)
                    if ok and pressed then return true end
                    if IsShooting then return true end
                    local now = tick()
                    if now - localLastClickTime < 1.8 then return true end
                    if now - (LastShotTime or 0) < 1.8 then return true end
                    if now - (LastAutoShootTime or 0) < 1.8 then return true end
                    return false
                end

                -- Tables de suivi des dégâts et debounce
                local KillFX_LastDmgBy = {}
                local KillFX_BotHooked = {}
                local KillFX_DeadHandled = {}

                -- Système de liaison pour les Joueurs
                local function BindPlayer(player)
                    if not player or player == LocalPlayer then return end
                    local function SetupChar(char)
                        if not char then return end
                        local hum = char:WaitForChild("Humanoid", 8)
                        if not hum then return end
                        local hrp = char:WaitForChild("HumanoidRootPart", 8)
                        local uid = player.UserId
                        local lastRecordedHP = hum.Health
                        local lastCharPos = hrp and hrp.Position or nil

                        local function TriggerPlayerKill()
                            if KillFX_DeadHandled[uid] then return end
                            if not KillEffectsSettings.Enabled then return end

                            if KillEffectsSettings.OnlyMyKills then
                                local lastDmgTime = KillFX_LastDmgBy[uid] or 0
                                local recentDmg = (tick() - lastDmgTime <= 3.5)
                                local shootingNow = IsLocalShooting()
                                if not recentDmg and not shootingNow then
                                    return
                                end
                            end

                            KillFX_DeadHandled[uid] = true
                            local spawnPos = (hrp and hrp.Parent and hrp.Position) or lastCharPos
                            PlayKillEffect(char, KillEffectsSettings.SelectedEffect, spawnPos)
                            KillFX_LastDmgBy[uid] = nil
                        end

                        hum.HealthChanged:Connect(function(newHP)
                            if newHP < lastRecordedHP then
                                if IsLocalShooting() then
                                    KillFX_LastDmgBy[uid] = tick()
                                end
                            end
                            lastRecordedHP = newHP
                            if newHP <= 0 then
                                TriggerPlayerKill()
                            end
                        end)

                        hum.Died:Connect(function()
                            TriggerPlayerKill()
                        end)

                        task.spawn(function()
                            while char and char.Parent and not KillFX_DeadHandled[uid] do
                                if hrp and hrp.Parent then
                                    lastCharPos = hrp.Position
                                end
                                if hum and hum.Health <= 0 then
                                    TriggerPlayerKill()
                                    break
                                end
                                task.wait(0.1)
                            end
                        end)

                        char.AncestryChanged:Connect(function(_, parent)
                            if not parent and not KillFX_DeadHandled[uid] then
                                local lastDmgTime = KillFX_LastDmgBy[uid] or 0
                                if (lastRecordedHP <= 25) or (tick() - lastDmgTime < 2.0) then
                                    TriggerPlayerKill()
                                end
                            end
                        end)
                    end

                    if player.Character then task.spawn(SetupChar, player.Character) end
                    player.CharacterAdded:Connect(function(char)
                        KillFX_DeadHandled[player.UserId] = nil
                        KillFX_LastDmgBy[player.UserId] = nil
                        task.spawn(SetupChar, char)
                    end)
                end

