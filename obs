            local function UpdateESP()
                if not ESPSettings.Enabled then return end
                local currentTime = tick()
                if currentTime - LastESPUpdate < ESPUpdateRate then return end
                LastESPUpdate = currentTime
                local myChar = LocalPlayer.Character
                if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
                local myPos = myChar.HumanoidRootPart.Position
                local playerDistances = {}
                for player, esp in pairs(ESPObjects) do
                    if not player or not player.Parent or not esp.character or not esp.character.Parent then
                        RemoveESP(player)
                    else
                        local character = esp.character
                        local rootPart = esp.rootPart
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        if not rootPart or not rootPart.Parent or (humanoid and humanoid.Health <= 0) then
                            RemoveESP(player)
                        else
                            local distance = (rootPart.Position - myPos).Magnitude
                            if ESPSettings.TeamCheck and player.Team == LocalPlayer.Team then
                                esp.billboard.Enabled = false
                                esp.highlight.Enabled = false
                            else
                                table.insert(playerDistances, {
                                    player = player,
                                    esp = esp,
                                    distance = distance,
                                    character = character,
                                    rootPart = rootPart,
                                    humanoid = humanoid
                                })
                            end
                        end
                    end
                end
                table.sort(playerDistances, function(a, b)
                    return a.distance < b.distance
                end)
                for i, data in ipairs(playerDistances) do
                    local esp = data.esp
                    local distance = data.distance
                    if i <= ESPSettings.MaxVisible then
                        if distance <= ESPSettings.MaxDistance then
                            esp.billboard.Enabled = ESPSettings.ShowNames or ESPSettings.ShowDistance or ESPSettings.ShowHealth
                            esp.highlight.Enabled = ESPSettings.ShowBoxes
                            local frame = esp.billboard.Frame
                            if frame then
                                local nameLabel = frame:FindFirstChild("Name")
                                if nameLabel then 
                                    nameLabel.Visible = ESPSettings.ShowNames 
                                    nameLabel.Text = MiscSettings.SpoofNames and "Bobby INC" or (data.player.DisplayName or data.player.Name)
                                end
                                local distLabel = frame:FindFirstChild("Distance")
                                if distLabel then
                                    distLabel.Visible = ESPSettings.ShowDistance
                                    local meters = distance / 3.5
                                    distLabel.Text = string.format("%.0fm", meters)
                                end
                                local healthLabel = frame:FindFirstChild("Health")
                                if healthLabel and data.humanoid then
                                    healthLabel.Visible = ESPSettings.ShowHealth
                                    local hp = math.floor(data.humanoid.Health)
                                    healthLabel.Text = hp .. " HP"
                                    local percent = data.humanoid.Health / data.humanoid.MaxHealth
                                    healthLabel.TextColor3 = Color3.new(1 - percent, percent, 0)
                                end
                    end
                    if ESPSettings.ShowSkeleton and data.character then
                        for boneIndex = 1, #SkeletonBones do
                            if not esp.skeleton[boneIndex] then
                                local line = Drawing.new("Line")
                                line.Thickness = 2
