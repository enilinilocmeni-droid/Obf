                local mn, mx = bat_worldBounds(list)
                return mn.Y, mx.Y
            end

            local function bat_fitBlock(clone, parts, id, root, fit, isMain, noAutoRot)
                clone:PivotTo(CFrame.new(clone:GetPivot().Position))
                local mn, mx = bat_worldBounds(parts)
                local size = mx - mn

                if isMain and size.Y > 0.01 then
                    local k = bat_adjS[id] or 1
                    if bat_autoSize and fit.height > 0.5 then k = k * fit.height / size.Y end
                    local wm, dm = bat_adjW[id] or 1, bat_adjD[id] or 1
                    local ok = pcall(function()
                        if clone:IsA("Model") then
                            clone:ScaleTo(clone:GetScale() * k)
                        else
                            local s = clone.Size
                            clone.Size = Vector3.new(s.X * k * wm, s.Y * k, s.Z * k * dm)
                        end
                    end)
                    if ok then
                        mn, mx = bat_worldBounds(parts)
                        size = mx - mn
                    end
                end

                local autoRot = (noAutoRot or size.X >= size.Z) and 0 or 90
                local c = (mn + mx) / 2
                local R = root.CFrame.Rotation * CFrame.Angles(0, math.rad(autoRot + (bat_adjRot[id] or 0)), 0)
                clone:PivotTo(CFrame.new(c) * R * CFrame.new(-c) * clone:GetPivot())

                mn, mx = bat_worldBounds(parts)
                local cx, cz = (mn.X + mx.X) / 2, (mn.Z + mx.Z) / 2
                clone:PivotTo(clone:GetPivot() + Vector3.new(
                    root.Position.X - cx,
                    fit.feetY - mn.Y + (bat_adjY[id] or 0),
                    root.Position.Z - cz
                ))
            end

            local BAT_SLICE = {
                shoulder = 0.30, elbow = 0.45, wrist = 0.60,
                neck = 0.86, hip = 0.50, knee = 0.28, ankle = 0.08,
                armMinT = 0.60,
                headHalfW = 0.35,
                legHalfW = 0.40,
                capeDepth = 0.35,
                armDrop = 75,
                swapSides = false,
                recentered = true,
                cutHead = false,
                overlap = 0.035,
